# Copy to .env. The one-click launcher generates LOCAL_API_TOKEN automatically;
# set it manually only when starting backend/frontend in separate terminals.
LOCAL_API_TOKEN=
BACKEND_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:8000
BACKEND_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1
BACKEND_PORT=8001
FRONTEND_PORT=8000
LOG_LEVEL=info

# Closing a browser tab never stops the service by default.
AUTO_SHUTDOWN_ON_IDLE=false
HEARTBEAT_TIMEOUT=300

# Runtime harness: cumulative graph/route-review budgets, including human resumes.
HARNESS_MAX_NODES=128
HARNESS_MAX_MODEL_CALLS=32
HARNESS_MAX_TOOL_CALLS=256
HARNESS_MAX_ACTIVE_SECONDS=300
HARNESS_MODEL_TIMEOUT_SECONDS=30
HARNESS_MODEL_OUTPUT_TOKENS=4096
HARNESS_MAX_PARALLEL_TASKS=4
HARNESS_MAX_PENDING_JOBS=32

# Optional model/RAG settings. Never commit real keys.
LLM_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano
# Local mode accepts loopback OpenAI-compatible APIs such as Ollama only.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=qwen3:8b
LOCAL_MODEL_API_KEY=
JOB_DB_FILE=data/jobs.sqlite3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Off by default because exported cards may contain proprietary process data.
RAG_STORE_EXPORTS=false

# Optional reviewed prompt profile; absent means the built-in baseline.
AGENT_PROMPT_PROFILE=

# Optional TencentDB-Agent-Memory v3 read-only retrieval. Disabled by default.
# The URL is the memory-core origin, NOT the proxy or panel URL.
# Remote origins require HTTPS; HTTP is allowed only on loopback.
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_URL=http://127.0.0.1:8420
AGENT_MEMORY_API_KEY=
AGENT_MEMORY_SERVICE_ID=
AGENT_MEMORY_TEAM_ID=
AGENT_MEMORY_AGENT_ID=
AGENT_MEMORY_USER_ID=
